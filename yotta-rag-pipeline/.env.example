# ==============================================================================
# YOTTA WORKSTREAM A: RAG PIPELINE CONFIGURATION
# Copy this file to .env and adjust values for your environment.
# Never commit .env to source control!
# ==============================================================================

# --- LLM Provider Selection ---
# Supported generation providers: openai | nvidia_nim | ollama | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT=30

# --- Embedding Provider Selection ---
# Supported embedding providers: sentence_transformers | openai | nvidia_nim | ollama | mock
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_REQUEST_TIMEOUT=30

# --- Provider Credentials & Endpoints ---

# 1. OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. NVIDIA NIM Configuration (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# 3. Llama / Ollama Configuration (Local or compatible hosted endpoint)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- RAG Ingestion & Retrieval Hyperparameters ---
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=3
RELEVANCE_THRESHOLD=0.5
MAX_RETRIES=1

# --- Operational Settings ---
LOG_LEVEL=INFO
